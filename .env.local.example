# FastAPI 백엔드 URL
# 개발: http://127.0.0.1:8000
# 프로덕션: Vercel 환경변수로 별도 관리 (이 파일은 커밋용 예시)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# 서버 전용 (Route Handler, Server Component에서만 사용 — 브라우저 미노출)
# Plan SC: R-06, SC-07
API_URL=http://127.0.0.1:8000
# 현재 프론트 코드에서 사용하지 않음 (참조 없음). 필요해지면 백엔드 SECRET_KEY와 같은 값을 .env.local에만 넣을 것
JWT_SECRET=your_jwt_secret